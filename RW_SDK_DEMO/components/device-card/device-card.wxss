.device-card {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  padding: 26rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #163c30, #0c7655);
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(12, 103, 75, 0.2);
}

.device-card.compact {
  min-height: 128rpx;
}

.ring-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  flex: none;
  border-radius: 50%;
  background: linear-gradient(145deg, #e8f1ed, #8ca79d);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.5);
}

.ring-hole {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #164b3a;
  box-shadow: inset 0 3rpx 8rpx rgba(0, 0, 0, 0.28);
}

.device-content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.device-heading {
  display: flex;
  align-items: center;
}

.device-name {
  overflow: hidden;
  flex: 1;
  font-size: 31rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-left: 14rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.status.online {
  background: rgba(157, 255, 214, 0.2);
  color: #bcffe0;
}

.status.pending {
  background: rgba(255, 225, 145, 0.2);
  color: #ffe9ad;
}

.status.offline {
  background: rgba(255, 255, 255, 0.14);
  color: #dce8e3;
}

.device-meta {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.device-identifiers {
  flex: 1;
  min-width: 0;
}

.device-address,
.device-id {
  display: block;
  line-height: 30rpx;
  word-break: break-all;
}

.device-address {
  color: rgba(255, 255, 255, 0.82);
}

.device-id {
  margin-top: 4rpx;
}

.device-power {
  flex: none;
  margin-left: 16rpx;
  line-height: 30rpx;
}

.arrow {
  margin-left: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 46rpx;
  font-weight: 200;
}
