.search-page {
  padding-top: 10rpx;
}

.scan-header {
  padding: 34rpx 24rpx 30rpx;
  text-align: center;
}

.radar {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  margin: 0 auto;
}

.radar-ring {
  position: absolute;
  border: 2rpx solid rgba(12, 155, 108, 0.28);
  border-radius: 50%;
}

.ring-one {
  top: 18rpx;
  left: 18rpx;
  width: 134rpx;
  height: 134rpx;
}

.ring-two {
  top: 42rpx;
  left: 42rpx;
  width: 86rpx;
  height: 86rpx;
}

.radar-center {
  position: absolute;
  top: 65rpx;
  left: 65rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #0c9b6c;
  box-shadow: 0 0 0 12rpx rgba(12, 155, 108, 0.1);
}

.radar.active .ring-one {
  animation: pulse 1.8s ease-out infinite;
}

.radar.active .ring-two {
  animation: pulse 1.8s 0.45s ease-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.72); opacity: 0.9; }
  100% { transform: scale(1.45); opacity: 0; }
}

.scan-title {
  font-size: 32rpx;
  font-weight: 650;
}

.scan-subtitle {
  margin-top: 9rpx;
  color: #8a948f;
  font-size: 23rpx;
}

.scan-countdown {
  margin-top: 8rpx;
  color: #0c9468;
  font-size: 22rpx;
}

.scan-button {
  width: 230rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #0c9b6c;
  color: #fff;
  font-size: 25rpx;
}

.scan-button.secondary {
  background: #e4f2ec;
  color: #087d59;
}

.search-device {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.search-device + .search-device {
  border-top: 1rpx solid #edf0ee;
}

.search-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border: 7rpx solid #7d968b;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-hole {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #fff;
}

.search-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.search-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-address,
.search-id {
  margin-top: 7rpx;
  color: #929c97;
  font-size: 21rpx;
  line-height: 30rpx;
  word-break: break-all;
}

.search-address {
  color: #74827b;
}

.signal {
  margin-left: 14rpx;
  text-align: right;
}

.signal-text {
  color: #46705f;
  font-size: 22rpx;
}

.signal-value {
  margin-top: 5rpx;
  color: #a0a8a4;
  font-size: 19rpx;
}

.connecting-dot {
  width: 24rpx;
  height: 24rpx;
  margin-left: 18rpx;
  border: 4rpx solid #cde9dd;
  border-top-color: #0c9b6c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.error-box {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff0f0;
  color: #c44c4c;
  font-size: 23rpx;
}

.log-heading {
  display: flex;
  justify-content: space-between;
  margin: 40rpx 4rpx 14rpx;
  color: #7b8681;
  font-size: 23rpx;
}

.copy-log {
  color: #0c9468;
}

.log-card {
  max-height: 260rpx;
  overflow: auto;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #1b2823;
}

.log-line,
.log-empty {
  color: #a8c4b8;
  font-family: monospace;
  font-size: 19rpx;
  line-height: 30rpx;
  word-break: break-all;
}

.log-empty {
  color: #71837b;
}
