.record-page {
  padding-bottom: 60rpx;
}

.page-heading {
  padding: 10rpx 4rpx 28rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #87928d;
  font-size: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-row + .info-row {
  border-top: 2rpx solid #eef2f0;
}

.recording-on {
  color: #d86a32;
  font-weight: 650;
}

.record-toggle {
  margin-top: 22rpx;
}

.file-heading {
  margin-top: 30rpx;
}

.file-cell {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
}

.file-cell + .file-cell {
  border-top: 2rpx solid #eef2f0;
}

.file-symbol {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #e7f3ee;
  color: #0c9568;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.file-main {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
}

.file-meta {
  margin-top: 6rpx;
  color: #87928d;
  font-size: 24rpx;
}

.transfer-track {
  margin-top: 12rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #e7ebe9;
  overflow: hidden;
}

.transfer-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #0c9568;
  transition: width 0.15s ease-out;
}

.file-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.mini-button {
  margin: 0;
  background: #e7f3ee;
  color: #0c9568;
  font-size: 24rpx;
  line-height: 2.1;
  border-radius: 12rpx;
}

.mini-button.danger {
  background: #fdeeec;
  color: #c05045;
}
